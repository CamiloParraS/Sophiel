    <!-- Setup wizard -->
    <string name="wiz_title">Setup</string>
    <string name="wiz_step">Step %1$d of %2$d</string>
    <string name="wiz_welcome_title">Welcome to Sophiel</string>
    <string name="wiz_welcome_text">It covers what shouldn\'t be seen on the screen. Everything happens on this phone.</string>
    <string name="wiz_welcome_go">Get started</string>
    <string name="wiz_welcome_note">%1$d short steps</string>
    <string name="wiz_go_app">Go to the app</string>
    <string name="wiz_skip">Skip</string>
    <string name="wiz_app_info">Open App info</string>
    <string name="wiz_overlay_text">Sophiel covers what should not be seen with a mask over other apps. It does not work without this permission.</string>
    <string name="wiz_overlay_row">Find Sophiel in the list and turn the permission on</string>
    <string name="wiz_service_text">The mask is fully opaque, stays on after the screen turns off or a restart, and protects Sophiel\'s settings.</string>
    <string name="wiz_keep_text">Sophiel keeps covering with the screen off or after a restart, without asking each time. It covers a little slower.</string>
    <string name="wiz_open_accessibility">Open Accessibility</string>
    <string name="wiz_service_row">Turn Sophiel on in Accessibility</string>
    <string name="wiz_service_row_text">Find it under Installed apps or Downloaded apps and turn it on</string>
    <string name="wiz_service_skip">If you skip it, the mask will look slightly see-through</string>
    <string name="wiz_shortcut">Leave the shortcut off</string>
    <string name="wiz_shortcut_text">If Android offers an accessibility shortcut for Sophiel, don\'t turn it on: the mask stops being opaque.</string>
    <string name="wiz_grey">Is the switch greyed out?</string>
    <string name="wiz_grey_text">1. Tap it and close the \"Restricted setting\" message.\n2. Open App info, tap ⋮ and choose \"Allow restricted settings\". The phone asks for its screen lock.\n3. Go back to Accessibility and turn Sophiel on.</string>
    <string name="wiz_awake_title">Keep Sophiel awake</string>
    <string name="wiz_awake_text">So Android doesn\'t close it while it protects.</string>
    <string name="wiz_awake_battery">Unrestricted battery</string>
    <string name="wiz_awake_battery_text">App info &gt; Battery &gt; Unrestricted</string>
    <string name="wiz_awake_samsung">Never auto sleeping apps</string>
    <string name="wiz_awake_samsung_text">Settings &gt; Battery &gt; Background usage limits &gt; Never auto sleeping apps &gt; add Sophiel</string>
