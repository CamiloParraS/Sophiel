<?xml version="1.0" encoding="utf-8"?>
<!-- D79: the pairing key and tokens never leave the two phones: not in cloud backup, not in device transfer (API 31+). -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="remote_child.xml" />
        <exclude domain="sharedpref" path="sophiel_remote.xml" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="remote_child.xml" />
        <exclude domain="sharedpref" path="sophiel_remote.xml" />
    </device-transfer>
</data-extraction-rules>
